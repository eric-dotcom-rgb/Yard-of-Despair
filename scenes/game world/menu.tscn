[node name="how to play" type="Label" parent="tutorial/window/VBoxContainer" unique_id=2029477571]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_acx1n")
theme_override_font_sizes/font_size = 30
text = "
Welcome to Yard of Despair !
This is a brief tutorial on how to play this game.
Keys for movement: up-W ; down-S; left-A; right-D
Fuction keys:
- F to farm the soil (so you can plant seed) and pick up you seed if you placed it wrong
- Left-Click to plant the seed and harvest the grown crop
- Numers from 1 to 5 to change type of seed to plant (Carrot, Hot chili pepper, Onion, Potato, Pumpkin)
After you pick up the crops, you can sell them at the market and get coins. 
These coins can be used to buy other seed to repeat the process.
"
horizontal_alignment = 1
vertical_alignment = 1

